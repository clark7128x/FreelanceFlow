<Window x:Class="FreelanceFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FreelanceFlow.ViewModels"
        xmlns:converters="clr-namespace:FreelanceFlow.Converters"
        Title="FreelanceFlow - Time Tracker" 
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="0,0,0,40">
                    <TextBlock Text="⏱️ FreelanceFlow" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Time Tracker &amp; Invoicer" FontSize="12" Foreground="#888888" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Timer Display -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceVariant1Brush}" Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="ACTIVE TIMER" Style="{StaticResource CaptionLabelStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ElapsedTimeFormatted}" Style="{StaticResource StatValueStyle}" FontSize="36" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding SelectedProject.ProjectName, FallbackValue='Select a project'}" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Center"/>

                        <TextBox Text="{Binding CurrentTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,16,0,0" Height="60"
                                 AcceptsReturn="True" TextWrapping="Wrap"/>

                        <Button Command="{Binding ToggleTimerCommand}" Margin="0,16,0,0" Padding="32,16" FontSize="16" FontWeight="Bold" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="border" Property="Background" Value="{StaticResource DisabledBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimerButtonIcon}" Margin="0,0,8,0" FontSize="18"/>
                                <TextBlock Text="{Binding TimerButtonText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="MENU" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,16"/>
                    <Button Content="📊 Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,4"/>
                    <Button Content="👥 Clients" Command="{Binding NavigateCommand}" CommandParameter="Clients" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,4"/>
                    <Button Content="📁 Projects" Command="{Binding NavigateCommand}" CommandParameter="Projects" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,4"/>
                    <Button Content="📝 Time Logs" Command="{Binding NavigateCommand}" CommandParameter="TimeLogs" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,4"/>
                </StackPanel>

                <!-- Quick Actions -->
                <StackPanel Grid.Row="3">
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,20"/>
                    <Button Content="📄 Export All Invoices" Command="{Binding ExportAllInvoicesCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,8"/>
                    <Button Content="🔄 Refresh Data" Command="{Binding RefreshDashboardCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">
            <!-- Loading Overlay -->
            <Border Background="#88121212" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="100">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource LoadingSpinnerStyle}" Width="200"/>
                    <TextBlock Text="Loading..." Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Dashboard View -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Dashboard}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Dashboard" Style="{StaticResource HeaderLabelStyle}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#888888"/>
                </StackPanel>

                <!-- Stats -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="HOURS TODAY" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock Text="{Binding TotalHoursTodayFormatted}" Style="{StaticResource StatValueStyle}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding TotalEarningsToday, StringFormat='${0:N2}'}" Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="HOURS THIS WEEK" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock Text="{Binding TotalHoursThisWeekFormatted}" Style="{StaticResource StatValueStyle}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding TotalEarningsThisWeek, StringFormat='${0:N2}'}" Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="PROJECTS" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock Text="{Binding DashboardProjects.Count}" Style="{StaticResource StatValueStyle}" Margin="0,8,0,0"/>
                            <TextBlock Text="active" Foreground="#888888"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="CLIENTS" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock Text="{Binding Clients.Count}" Style="{StaticResource StatValueStyle}" Margin="0,8,0,0"/>
                            <TextBlock Text="managed" Foreground="#888888"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Projects Grid -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Projects Overview (Select to track time)" Style="{StaticResource SubHeaderLabelStyle}"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding DashboardProjects}" SelectedItem="{Binding SelectedProject}"
                                  Style="{StaticResource ModernDataGridStyle}" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                                  CellStyle="{StaticResource ModernDataGridCellStyle}" RowStyle="{StaticResource ModernDataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="150"/>
                                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="200"/>
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Rate/Hr" Binding="{Binding HourlyRate, StringFormat='${0:N2}'}" Width="100"/>
                                <DataGridTextColumn Header="Today" Binding="{Binding HoursTodayFormatted}" Width="100"/>
                                <DataGridTextColumn Header="This Week" Binding="{Binding HoursThisWeekFormatted}" Width="100"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalHoursFormatted}" Width="100"/>
                                <DataGridTextColumn Header="Earnings" Binding="{Binding TotalEarnings, StringFormat='${0:N2}'}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Export Invoice" Command="{Binding ExportInvoiceCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="0,0,12,0"/>
                            <Button Content="Delete Project" Command="{Binding DeleteProjectCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource ErrorBrush}" Padding="16,8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Clients View -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Clients}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Manage Clients" Style="{StaticResource HeaderLabelStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Client Name" Style="{StaticResource CaptionLabelStyle}"/>
                            <TextBox Text="{Binding NewClientName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="Email" Style="{StaticResource CaptionLabelStyle}"/>
                            <TextBox Text="{Binding NewClientEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="12,0">
                            <TextBlock Text="Rate/Hr" Style="{StaticResource CaptionLabelStyle}"/>
                            <TextBox Text="{Binding NewClientRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="3" Content="Add Client" Command="{Binding AddClientCommand}" Style="{StaticResource ModernButtonStyle}" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceVariant1Brush}" CornerRadius="8" Padding="16" Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}"/>
                                                <TextBlock Text="{Binding Email}" Foreground="#888888" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DefaultHourlyRate, StringFormat='${0:N2}/hr'}" Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="1" Content="Delete Selected" Command="{Binding DeleteClientCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="16,8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Projects View -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Projects}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Manage Projects" Style="{StaticResource HeaderLabelStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Client" Style="{StaticResource CaptionLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="Project Name" Style="{StaticResource CaptionLabelStyle}"/>
                            <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="12,0">
                            <TextBlock Text="Description" Style="{StaticResource CaptionLabelStyle}"/>
                            <TextBox Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="12,0">
                            <TextBlock Text="Rate/Hr" Style="{StaticResource CaptionLabelStyle}"/>
                            <TextBox Text="{Binding NewProjectRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="4" Content="Add Project" Command="{Binding AddProjectCommand}" Style="{StaticResource ModernButtonStyle}" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <DataGrid ItemsSource="{Binding DashboardProjects}" SelectedItem="{Binding SelectedProject}"
                              Style="{StaticResource ModernDataGridStyle}" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}" RowStyle="{StaticResource ModernDataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="150"/>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="*"/>
                            <DataGridTextColumn Header="Rate" Binding="{Binding HourlyRate, StringFormat='${0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Total Hours" Binding="{Binding TotalHoursFormatted}" Width="120"/>
                            <DataGridTextColumn Header="Earnings" Binding="{Binding TotalEarnings, StringFormat='${0:N2}'}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Time Logs View -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=TimeLogs}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Recent Time Logs" Style="{StaticResource HeaderLabelStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding RecentTimeLogs}" SelectedItem="{Binding SelectedTimeLog}"
                                  Style="{StaticResource ModernDataGridStyle}" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                                  CellStyle="{StaticResource ModernDataGridCellStyle}" RowStyle="{StaticResource ModernDataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd}'}" Width="110"/>
                                <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" Width="80"/>
                                <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat='{}{0:HH:mm}'}" Width="80"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}, ConverterParameter=full}" Width="100"/>
                                <DataGridTextColumn Header="Project" Binding="{Binding Project.Name}" Width="200"/>
                                <DataGridTextColumn Header="Client" Binding="{Binding Project.Client.Name}" Width="150"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Earnings" Binding="{Binding Earnings, StringFormat='${0:N2}'}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Grid.Row="1" Content="Delete Selected" Command="{Binding DeleteTimeLogCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="16,8"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>